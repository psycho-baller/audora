{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "include": [
    "src",
    "tests"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "noEmit": false,
    "declaration": true
  }
}
